[Unit]
# v245: read the books and the project files from Google Drive into
# PostgreSQL (fin_source_file keeps every file by content hash — an
# unchanged file is skipped, so the daily run costs nothing between
# monthly closes). Folder ids and the entity come from /root/.argia_env
# (ARGIA_FIN_DRIVE_REPORTING / _OVERVIEW / _PM / _TRACKER, ARGIA_FIN_ENTITY);
# the service account must have Viewer on those folders.
Description=ARGIA finance: Drive books + project files -> PostgreSQL (daily)
Wants=network-online.target
After=network-online.target postgresql.service
[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/root/argia_v2/v2/pi/run_job.sh fin-drive fin_drive_ingest.py --drive --apply
