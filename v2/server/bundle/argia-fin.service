[Unit]
# v244: the finance snapshot + project portfolio (/finance/, /projects/).
# nginx proxies both prefixes here behind the session login; the app
# allow-lists WHO may see them (ARGIA_FIN_EMAILS / ARGIA_FIN_ALLOW —
# Tomasz only while the modules are being built) and answers 403 to
# everyone else. Reads PostgreSQL only in this slice. The entity shown
# is DEMO-MX until the real legal entities are configured.
Description=ARGIA finance + projects (/finance/, /projects/)
After=network.target postgresql.service
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/opt/argia/bundle
Environment=HOME=/root
Environment=ARGIA_V2_DIR=/root/argia_v2/v2
Environment=ARGIA_FIN_PORT=8515
Environment=ARGIA_FIN_EMAILS=tomasz.zemelka@argia.com.mx
# more people: one e-mail per line in this file, read live, no restart
Environment=ARGIA_FIN_ALLOW=/opt/argia/auth/fin_allow.txt
Environment=ARGIA_FIN_ENTITY=DEMO-MX
ExecStart=/usr/bin/python3 /opt/argia/bundle/fin_app.py
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
