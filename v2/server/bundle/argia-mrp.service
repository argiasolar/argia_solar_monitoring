[Unit]
# v363: ARGIA for Grupo MRP - the same platform as ARGIA for Prologis
# (prologis_app.py), third instance on 127.0.0.1:8522 with its own data,
# users, MFA and audit log in /opt/argia/mrp (root-only, never in git).
# Client name and wording: /opt/argia/mrp/client.json.
Description=ARGIA for Grupo MRP (mrp.argia.com.mx)
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/opt/argia/bundle
Environment=HOME=/root
Environment=ARGIA_V2_DIR=/root/argia_v2/v2
Environment=ARGIA_PL_DIR=/opt/argia/mrp
Environment=ARGIA_PL_DB=/opt/argia/mrp/mrp.db
Environment=ARGIA_PL_FILES=/opt/argia/mrp/files
Environment=ARGIA_PL_REGISTRY=/opt/argia/mrp/registry.json
Environment=ARGIA_PL_PORT=8522
# v376 (Tomasz, 13 Nov 2026): no authenticator on MRP until this day; MFA comes back by itself the day after
Environment=ARGIA_PL_MFA_OFF_UNTIL=2026-12-31
ExecStart=/usr/bin/python3 /opt/argia/bundle/prologis_app.py
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
