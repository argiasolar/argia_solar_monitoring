[Unit]
Description=Daily ARGIA KPI sync at 14:10 UTC (after the v2-kpi-export Action)
# Chain (2026-08-27 fix): argia-kpi stamps yesterday at 06:00 MX (12:00
# UTC) -> v2-kpi-export pushes the data branch 13:40 UTC -> this sync
# 14:10 UTC loads it into PostgreSQL. The old 07:40 UTC ran BEFORE both
# and made daily_production lag a full extra day.

[Timer]
OnCalendar=*-*-* 14:10:00 UTC
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
